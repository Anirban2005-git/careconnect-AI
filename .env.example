# GEMINI_API_KEY: Required for Gemini AI API calls (backend only — never expose in frontend).
# GEMINI_API_KEY: Required for Gemini AI API calls (backend only — never expose in frontend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MongoDB connection string. Leave as placeholder to use in-memory demo store.
MONGODB_URI="MY_MONGODB_URI"

# Firebase Admin SDK (backend token verification)
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="MY_FIREBASE_CLIENT_EMAIL"
FIREBASE_PRIVATE_KEY="MY_FIREBASE_PRIVATE_KEY"

# Google Maps Platform (optional — mock provider data used when unavailable)
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# App URL
APP_URL="http://localhost:3000"

# Frontend Firebase config (Vite — prefix with VITE_)
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
